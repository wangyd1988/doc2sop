# Copy to .env and fill in. Keep the file LF-only with no BOM:
# a stray \r makes every value silently wrong inside the container.
#
# 5 分钟跑通演示只需要改两处：WEB_PASSWORD 和 LLM_API_KEY（步骤见 docs/五分钟演示.md）。

# --- 一键演示 ----------------------------------------------------------------
# demo profile 会多起一个极小的只读工具容器 kb-ops（见 docker-compose.yml）。正式部署留空。
COMPOSE_PROFILES=demo
# 模型配好后自动导入的场景包：packs/ 下的目录名，逗号分隔；留空不导入。格式见 docs/场景包.md
DEMO_PACKS=leave-planning,model-selfcheck
# 国内网络 `docker compose up` 卡在拉取 python:3.12-slim（Docker Hub 不可达）时，打开这一行换成镜像站再 up
# BASE_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
# pip 装依赖慢时换国内源（compose 和 deploy/release.sh 都认），留空用官方 PyPI
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# 一台机器跑第二套（比如正式站旁边再起一个演示站）时，在另一个目录 clone，然后只改这几个；默认值在 docker-compose.yml 里。
# 端口改 APP_PORT（宿主机侧），不要动下面的 PORT（容器内端口）。
# APP_CONTAINER=demo-app
# OPS_CONTAINER=demo-ops
# APP_IMAGE=demo-app:latest
# OPS_IMAGE=demo-ops:latest
# APP_PORT=8766
# APP_MEM_LIMIT=700m
# APP_CPUS=1.5

# --- Model endpoints ---------------------------------------------------------
# 推荐硅基流动（https://cloud.siliconflow.cn）：一把 key 同时有对话模型和向量模型 BAAI/bge-m3，
# 注册后在「API 密钥」页新建。模型名以它的「模型广场」为准。
# 也可以全部留空，启动后在页面 /manage → 模型设置 里填，保存即生效；但那样演示里「模型网关」组的
# 工具拿不到 key，会提示「未配置」（工具凭据永远不经过页面）。
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=
CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash
EMBED_MODEL=BAAI/bge-m3
#
# 其他两种写法：
# A. 有网关（LiteLLM / OneAPI，OpenAI 兼容）：一个地址一把 key 管所有模型
#    LLM_BASE_URL=http://127.0.0.1:4000/v1   LLM_API_KEY=sk-...   CHAT_MODEL=kb-chat   EMBED_MODEL=kb-embedding
# B. 没有网关、对话和向量来自两家：对话填上面四项，向量厂商填下面两项（留空 = 和对话模型同一处）
#    EMBED_BASE_URL=https://api.siliconflow.cn/v1   EMBED_API_KEY=sk-...   EMBED_MODEL=BAAI/bge-m3
EMBED_BASE_URL=
EMBED_API_KEY=
# 重排模型（网关上的 rerank 模型名，如 LiteLLM 里接 deploy/embedding/rerank_server.py 的 kb-rerank）。留空不重排。
RERANK_MODEL=
RERANK_CANDIDATES=8
# 向量模型请求超时（秒）：查询一条问题 / 入库每批（≤16 段）各一个。查询超时不会让提问失败，
# 会降级为只按关键词召回并在来源里标出；自托管 CPU 向量服务入库慢，所以入库的上限宽得多。
# EMBED_TIMEOUT=15
# EMBED_INGEST_TIMEOUT=120
# 图片识别模型，按顺序尝试；留空则不识别文档内的图片
VISION_MODELS=

# Only set this for models verified to honour it. Some gateways answer
# reasoning_effort=none by merging the reasoning into the answer text.
REASONING_EFFORT=

# --- Web ---------------------------------------------------------------------
WEB_USER=admin
WEB_PASSWORD=replace-with-a-long-random-password
PORT=8765
# 助手叫什么：页面标题、顶栏、自称都用它。想给助手起个团队自己的名字就填这里，留空就叫 doc2sop。
# BOT_NAME=

# --- Retrieval ---------------------------------------------------------------
TOP_K=8
MIN_SCORE=0.25
HISTORY_MESSAGES=8
CHUNK_SIZE=400
CHUNK_OVERLAP=50

# --- Ingestion ---------------------------------------------------------------
MAX_FILE_MB=50
MAX_IMAGES_PER_FILE=40
VISION_WORKERS=3

# --- Observability (optional) ------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=doc2sop

# --- Read-only ops tools -----------------------------------------------------
# 演示：指向随附的 sidecar，令牌由两个容器自动共用这一个值——换成任意一串随机字符即可。
# 正式部署：在宿主机上跑 deploy/ops_readonly.py，OPS_URL 改成它的地址（如 http://127.0.0.1:8799）。
# OPS_URL 留空则不启用工具，退化为纯知识库问答。
OPS_URL=http://kb-ops:8799
OPS_TOKEN=replace-with-a-random-string
# auto = 有工具就用，off = 强制关闭工具
AGENT_MODE=auto

# --- 知识检索工具化（可选） --------------------------------------------------
# true：模型能自己补查知识库（kb_search 换说法再查、kb_read 读前后文、kb_catalog 看目录）；
# 没有工具服务、也没开联网时也会因此走 Agent。默认关，关着时行为和以前完全一样。
KB_TOOLS=false
# 只在 KB_TOOLS=true 时起作用：prefetch 先检索一次、不够再补查（默认）；forced 第一轮强制模型检索；agentic 由模型决定
KB_RETRIEVAL_MODE=prefetch
# true：待办清单工具 plan，「▶ 执行」时按 SOP 步骤预填，长 SOP 不漏步
PLAN_TOOL=false
# 评测（eval/run_eval.py --mode）按请求覆盖上面两个开关时要带的令牌。留空则应用启动时生成在 DATA_DIR/eval_token。
# EVAL_TOKEN=

# --- Web search (optional) ---------------------------------------------------
# 知识库答不了时上网搜索。填 LiteLLM 网关里 search_tools 的名字，留空则不启用。
# 走网关的好处：内网只要能访问网关就能搜，搜索服务的 key 只放在网关上。
WEB_SEARCH_TOOL=
WEB_SEARCH_MAX_RESULTS=5
# 永远不发往搜索引擎的内部名词，逗号分隔（IP、密钥、邮箱、内网域名已内置拦截）
WEB_SEARCH_BLOCKLIST=

# --- 读网页与出网规则（可选） ------------------------------------------------
# true：联网时多一个 web_fetch，能读本轮搜索结果或用户消息里给的链接的正文（要和 WEB_SEARCH_TOOL 一起用）。默认关。
# 只发 GET、只收文本、最多 2 MB；内网、回环、云元数据地址一律连不上（docs/工具.md「外网类工具与出网规则」）。
WEB_FETCH=false
# web_fetch 的出口代理，http://主机:端口（可带账号密码）；留空直连。DNS 仍在本机解析，代理要放行 CONNECT 到 443（http 链接还有 80）。
WEB_FETCH_PROXY=
# 一轮里查过真实数据（调过数据工具）之后还能不能联网：screen（默认）照常联网，但搜索词和链接里不能带本轮查到的内部名字；
# deny 这一轮不再联网。
WEB_AFTER_DATA=screen

# --- SOP 沉淀（可选） --------------------------------------------------------
# 一次自由排查用了 ≥2 个工具并得出结论时，回答末尾提议把它沉淀为 SOP（默认停用，需人确认）。
# false 关闭自动提议；每天最多提几条。
AUTO_SOP_PROPOSALS=true
SOP_PROPOSALS_PER_DAY=10
