# Copy to .env and fill in. Keep the file LF-only with no BOM:
# a stray \r makes every value silently wrong inside the container.

# --- Model gateway (LiteLLM, OpenAI-compatible) ------------------------------
LLM_BASE_URL=http://127.0.0.1:4000/v1
LLM_API_KEY=sk-replace-with-your-gateway-key

# Model aliases as defined in litellm/config.yaml
CHAT_MODEL=kb-chat
EMBED_MODEL=kb-embedding
# Tried in order; the first one that answers wins.
VISION_MODELS=kb-vision

# Only set this for models verified to honour it. Some gateways answer
# reasoning_effort=none by merging the reasoning into the answer text.
REASONING_EFFORT=

# --- Web ---------------------------------------------------------------------
WEB_USER=admin
WEB_PASSWORD=replace-with-a-long-random-password
PORT=8765
BOT_NAME=小知

# --- Retrieval ---------------------------------------------------------------
TOP_K=8
MIN_SCORE=0.25
HISTORY_MESSAGES=8
CHUNK_SIZE=400
CHUNK_OVERLAP=50

# --- Ingestion ---------------------------------------------------------------
MAX_FILE_MB=50
MAX_IMAGES_PER_FILE=40
VISION_WORKERS=3

# --- Observability (optional) ------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=personal-kb

# --- Read-only ops tools (optional) ------------------------------------------
# 留空则不启用工具，退化为纯知识库问答。
# 服务端用 deploy/ops_readonly.py 启动，只监听 127.0.0.1。
OPS_URL=
OPS_TOKEN=
# auto = 有工具就用，off = 强制关闭工具
AGENT_MODE=auto

# --- Web search (optional) ---------------------------------------------------
# 知识库答不了时上网搜索。填 LiteLLM 网关里 search_tools 的名字，留空则不启用。
# 走网关的好处：内网只要能访问网关就能搜，搜索服务的 key 只放在网关上。
WEB_SEARCH_TOOL=
WEB_SEARCH_MAX_RESULTS=5
# 永远不发往搜索引擎的内部名词，逗号分隔（IP、密钥、邮箱、内网域名已内置拦截）
WEB_SEARCH_BLOCKLIST=
