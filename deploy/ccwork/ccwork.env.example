# /etc/doc2sop-ccwork.env：云上协同转接程序的开关和凭据（root 600；不进备份）。
# app-key、app-secret 不要手抄进来：执行 python3 /opt/doc2sop-ccwork/ccwork_bridge.py set-credentials，
# 它从标准输入读（终端上不回显），原子写入、权限 600、旧文件留 .bak-时间。
# 改了以后只重启转接程序：systemctl restart doc2sop-ccwork（kb-app 不用动）。

# 总开关：false 时不取凭据、不连 MQTT、不解密任何东西，只回 /health
CCWORK_ENABLED=false
# 只收不发（试连第 2 步）；on 才往云上协同发消息
CCWORK_SEND=off
# 开放平台接口的正式地址（只接受 https://，向管理员或开放平台文档确认）
CCWORK_BASE_URL=
# 组织路由（查 MQTT 地址用），一般就是这个
CCWORK_SAAS_HOST=https://r.ccwork.com
# MQTT 的加密地址 ssl://主机:端口；不知道就先跑 ccwork_bridge.py check，它会探测并给出建议
CCWORK_BROKER=
# broker 不支持加密、又要排查时才写 diagnose：连得上、收得到、计数，但不交给 kb-app、不发任何东西
CCWORK_ALLOW_PLAINTEXT=
# 本地接口的令牌：openssl rand -hex 32；kb-app 的 .env 里 CHAT_BRIDGE_TOKEN 填同一个值
CHAT_BRIDGE_TOKEN=

# 以下一般不用改
# CCWORK_LISTEN=127.0.0.1:8796
# CCWORK_TARGETS_FILE=/etc/doc2sop-ccwork/targets.yaml
# 私有 CA 签的证书才填；填了就只信它，不再用系统根证书
# CCWORK_CA_FILE=
