# /etc/doc2sop-ccwork/targets.yaml（root:doc2sop-ccwork 640；没有密钥；改了不用重启）
#
# 推送目标：kb-app（计划、告警规则、每周缺口摘要）只能按这里的名字推送，拿不到也改不了原始 ID。
# 群 ID、用户 ID 从网页「云上协同」卡片的「最近 @ 过、还没开通的」里抄。每个目标每小时最多 20 条，多的合并成一条。
targets:
  # 运维值班群: {chat_id: "1234567890123"}
  # 王某某: {user_id: "u_abc123"}

# 这些发送人的消息直接丢掉，不交给 kb-app（别的机器人、服务账号的用户 ID）
deny_senders: []
