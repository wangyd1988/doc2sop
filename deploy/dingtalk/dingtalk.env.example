# /etc/doc2sop-dingtalk.env：钉钉转接程序的开关和凭据（root 600；不进备份）。
# Client ID、Client Secret 不要手抄进来，也不要发到任何聊天、文档、截图里：执行
#   python3 /opt/doc2sop-dingtalk/dingtalk_bridge.py set-credentials
# 它从标准输入读（终端上不回显），原子写入、权限 600。旧文件只留最近一份 .bak-时间（里面是旧凭据），
# 确认新凭据能用以后把它也删掉。
# 改了以后只重启转接程序：systemctl restart doc2sop-dingtalk（kb-app 不用动）。

# 总开关：false 时不换令牌、不连钉钉，只回 /health
DINGTALK_ENABLED=false
# 只收不发（试连时先用 off）；on 才往钉钉发消息。off 时 kb-app 先不要配 CHAT_BRIDGE_URL
DINGTALK_SEND=off
# 本地接口的令牌：openssl rand -hex 32；kb-app 的 .env 里 CHAT_BRIDGE_TOKEN 填同一个值
CHAT_BRIDGE_TOKEN=

# 以下一般不用改
# DINGTALK_LISTEN=127.0.0.1:8795
# DINGTALK_TARGETS_FILE=/etc/doc2sop-dingtalk/targets.yaml
# 机器人的 robotCode，企业内部应用里就是 Client ID，不填即可
# DINGTALK_ROBOT_CODE=
# 只有测试时才填：填了就只信这个 CA，不再用系统根证书
# DINGTALK_CA_FILE=
