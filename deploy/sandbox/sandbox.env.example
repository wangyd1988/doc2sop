# 计算沙箱服务的环境变量：放在 /etc/doc2sop-sandbox.env，root:root 600。
# 令牌在宿主机上生成，不要打印出来：
#   umask 077; printf 'SANDBOX_TOKEN=%s\n' "$(python3 -c 'import secrets; print(secrets.token_urlsafe(36))')" > /etc/doc2sop-sandbox.env
SANDBOX_TOKEN=
# 镜像（默认 doc2sop-sandbox:latest）。换镜像要重启服务
# SANDBOX_IMAGE=doc2sop-sandbox:latest
# 同时最多运行几个（默认 1，最多 2）。2 核 2GB 的机器上保持 1
# SANDBOX_CONCURRENCY=1
# 满了排队等多少秒（默认 10，0 = 直接拒绝）
# SANDBOX_QUEUE_SECONDS=10
