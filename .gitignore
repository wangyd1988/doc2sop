# Secrets and local config
.env
*.env
!.env.example

# Runtime data: vector store, uploads, conversations, OCR cache
data/
*.db
*.db-shm
*.db-wal
vision_cache.json

# Personal documents must never be committed
uploads/
my_kb/

# 私有评测集与结果（针对真实知识库，可能含敏感内容）
eval/*.local.jsonl
eval/result*.json

# 工具定义的旁路文件：页面改的开关与说明、待审申请、脚本信任表，都是本机运行状态
deploy/ops_tools.overrides.yaml
deploy/ops_tools.pending.yaml
deploy/ops_tools.trust.yaml

# 公司内部活动的投递材料，不随开源仓库发布
docs/1024-*

# 演示 GIF 的录制中间产物（deploy/demo/record.js）：无损素材、剪辑片、调色板、时刻记录
docs/media/raw/

